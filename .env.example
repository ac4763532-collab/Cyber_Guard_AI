# CyberGuard AI - Root Environment Configuration
#
# This is the root-level .env consumed by docker-compose.yml's ${VAR}
# substitutions (not the backend/frontend app configs - those have their
# own .env.example files in backend/ and frontend/, used only when running
# those apps directly outside Docker).
#
# Copy this file to .env in the project root and fill in real values.
# Never commit the real .env file.

# Password for the LAPTOP-installed PostgreSQL "cyberguard" role (the
# CyberGuard_AI database). Docker does NOT run its own Postgres container -
# containers reach the host's real Postgres via host.docker.internal.
# Required - compose fails fast if this is unset.
DB_PASSWORD=

# Flask/FastAPI session signing key. Generate with: openssl rand -hex 32
SECRET_KEY=

# Claude API key for the LLM-backed agents (optional - LLM runs in mock
# mode without one, per app/api/v1/health.py's /detailed check).
ANTHROPIC_API_KEY=

# Firebase project used by both backend (token verification) and frontend
# (client SDK, baked into the frontend bundle at build time via
# frontend/Dockerfile's build ARGs - see docker-compose.yml's
# frontend.build.args).
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
