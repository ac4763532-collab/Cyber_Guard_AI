{
  "name": "cyberguard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CyberGuard AI — Frontend (React + Vite + Tailwind)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
