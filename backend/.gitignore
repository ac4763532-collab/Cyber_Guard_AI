# ============================================================================
# CyberGuard AI — Backend .gitignore
# ============================================================================
# SECURITY NOTE:
#   This is a cybersecurity platform. Any secret accidentally committed
#   to git must be treated as compromised and rotated immediately.
#   Rules below are intentionally strict — do not relax them.
# ============================================================================


# ────────────────────────────────────────────────────────────────────────────
# SECRETS & CREDENTIALS — NEVER COMMIT THESE
# ────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
firebase-service-account.json
firebase-service-account*.json
service-account*.json
credentials.json
secrets.json
*_secret*
*_credentials*
!*_credentials.py
!credentials_service.py


# ────────────────────────────────────────────────────────────────────────────
# PYTHON
# ────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
*.cover
.cache

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyright/

# Jupyter
.ipynb_checkpoints/


# ────────────────────────────────────────────────────────────────────────────
# VIRTUAL ENVIRONMENTS
# ────────────────────────────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.python-version


# ────────────────────────────────────────────────────────────────────────────
# DATABASE & DATA
# ────────────────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.dump
*.sql.gz
pgdata/
pg_data/


# ────────────────────────────────────────────────────────────────────────────
# UPLOADS, REPORTS, EVIDENCE — NEVER COMMIT
# ────────────────────────────────────────────────────────────────────────────
static/uploads/
static/reports/
static/evidence/
static/tmp/
media/
uploads/
evidence/
reports/
*.pdf
*.docx
*.xlsx
*.zip
*.tar
*.tar.gz
*.7z
*.rar
!docs/**/*.pdf


# ────────────────────────────────────────────────────────────────────────────
# LOGS
# ────────────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*
log/
*.pid
*.seed
*.pid.lock


# ────────────────────────────────────────────────────────────────────────────
# ALEMBIC BACKUPS & LOCAL ARTIFACTS
# ────────────────────────────────────────────────────────────────────────────
alembic/versions/*.py.bak
alembic/versions/*.orig
alembic/versions/.tmp/
*.orig
*.rej


# ────────────────────────────────────────────────────────────────────────────
# IDE & EDITORS
# ────────────────────────────────────────────────────────────────────────────
.vscode/
!.vscode/settings.example.json
!.vscode/launch.example.json
!.vscode/extensions.example.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.history/
.vscode-test/


# ────────────────────────────────────────────────────────────────────────────
# OPERATING SYSTEM
# ────────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/


# ────────────────────────────────────────────────────────────────────────────
# OS / BUILD ARTIFACTS
# ────────────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
*.swp
*.swo
*.pid
*.orig
*.rej
.cache/
tmp/
temp/
.crush


# ────────────────────────────────────────────────────────────────────────────
# NODE (in case backend has any tooling)
# ────────────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*


# ────────────────────────────────────────────────────────────────────────────
# DOCKER LOCAL OVERRIDES
# ────────────────────────────────────────────────────────────────────────────
docker-compose.override.yml
.docker/


# ────────────────────────────────────────────────────────────────────────────
# TEST / DEV DATA
# ────────────────────────────────────────────────────────────────────────────
test_data/
test_uploads/
test_reports/
fixtures/*.db
fixtures/*.json
!fixtures/*.example.json
seed_data/
*.seed
!scripts/seed_data.example.py


# ────────────────────────────────────────────────────────────────────────────
# MISC
# ────────────────────────────────────────────────────────────────────────────
*.bak
*.backup
*.old
*.save
*.orig
.DS_Store*
Thumbs.db*
desktop.ini
*.crdownload
*.part
*.download