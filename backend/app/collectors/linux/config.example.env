# CyberGuard AI — Linux Collector Example Configuration
# ============================================================================
# TEMPLATE for local development and testing.
#
# Production settings live in /etc/cyberguard/collector/config.json
# (written automatically by `sudo python3 main.py enroll <token>`).
#
# Copy this file to .env to override settings during development OR
# leave it at /etc/cyberguard/collector/.env for the systemd unit's
# EnvironmentFile= directive to load.
#
# Priority (highest to lowest):
#   1. CLI arguments (parsed by main.py)
#   2. This .env file (dev OR systemd EnvironmentFile)
#   3. /etc/cyberguard/collector/config.json (production config)
#   4. Hardcoded defaults in config.py
# ============================================================================


# ── Backend connection ──────────────────────────────────────────────────────
# URL of the CyberGuard backend. Include scheme.
CG_BACKEND_URL=http://localhost:8000


# ── Event source toggles ────────────────────────────────────────────────────
# Read systemd journal via `journalctl -o json`
# Requires: root (or user in 'systemd-journal' group)
CG_USE_JOURNALD=true

# Read from log files via byte-offset tailing
# Requires: read permission on the configured paths
CG_USE_LOG_FILES=true


# ── Log file paths ──────────────────────────────────────────────────────────
# Comma-separated list of files to tail.
# Missing files are tolerated — the reader simply skips them.
# Common paths by distro:
#   Debian/Ubuntu:  /var/log/auth.log, /var/log/syslog, /var/log/kern.log
#   RHEL/CentOS:    /var/log/secure, /var/log/messages, /var/log/audit/audit.log
#   Arch:           /var/log/auth.log (if configured), /var/log/messages
#   Alpine:         /var/log/messages (openrc syslog)
CG_LOG_FILES=/var/log/auth.log,/var/log/secure,/var/log/syslog,/var/log/messages,/var/log/audit/audit.log,/var/log/kern.log


# ── Journald filtering ──────────────────────────────────────────────────────
# Comma-separated systemd units to read. Empty = ALL units.
# The dispatcher on the backend filters by relevance — you generally
# don't need to narrow this unless the host runs many noisy services.
# Example: CG_JOURNALD_UNITS=sshd.service,sudo.service,systemd-logind.service
CG_JOURNALD_UNITS=


# ── Reader behaviour ────────────────────────────────────────────────────────
# How often the reader polls the journald + file sources (seconds).
# Minimum 1, recommended 5–10. Lower = higher CPU on busy systems.
CG_READ_POLL_SECONDS=5

# Max journald entries per `journalctl` invocation
CG_JOURNALD_BATCH_SIZE=100

# Max lines to read per file per poll
CG_FILE_TAIL_BATCH_LINES=100

# Max total events pulled per poll cycle (journald + files combined)
CG_MAX_EVENTS_PER_POLL=500


# ── Batching & sending ──────────────────────────────────────────────────────
# How many events to send per HTTP request. Backend caps batch at 500.
CG_BATCH_SIZE=100

# Flush interval for the sender (seconds). Min 1, recommended 10–30.
CG_BATCH_INTERVAL_SECONDS=10

# Max retries for a failed batch before dropping it.
CG_SEND_RETRY_MAX=5

# Base backoff between retries (seconds). Exponential: 5s, 10s, 20s, …
# Capped at 300s.
CG_SEND_RETRY_BACKOFF_SECONDS=5


# ── Heartbeat ───────────────────────────────────────────────────────────────
# How often to send a heartbeat (seconds). Backend marks source as
# "disconnected" after 300s of silence — keep this at least 2× below that.
CG_HEARTBEAT_INTERVAL_SECONDS=60


# ── Local queue ─────────────────────────────────────────────────────────────
# Max events held in the local SQLite queue. When exceeded, oldest drop.
# 10,000 events ≈ 10–20 MB on disk.
CG_MAX_QUEUE_SIZE=10000


# ── HTTP timeout ────────────────────────────────────────────────────────────
# Per-request timeout (seconds). Backend responses are usually <500ms.
CG_HTTP_TIMEOUT_SECONDS=30


# ── Logging ─────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
CG_LOG_LEVEL=INFO