# CyberGuard AI — Windows Collector Example Configuration (.env)
# ============================================================================
# This file is a TEMPLATE for local development and testing.
#
# In production, settings live in %PROGRAMDATA%\CyberGuard\config.json
# (populated by `python main.py enroll <token>` after successful enrollment).
#
# Copy this file to `.env` in the same directory as main.py to override
# settings during development. The .env file is optional — the collector
# runs fine with defaults from config.py if it doesn't exist.
#
# Priority (highest to lowest):
#   1. CLI arguments (none currently — collector runs headless)
#   2. This .env file (dev convenience)
#   3. %PROGRAMDATA%\CyberGuard\config.json (production config)
#   4. Hardcoded defaults in config.py
# ============================================================================

# ── Backend connection ──────────────────────────────────────────────────────
# URL of the CyberGuard backend. Include scheme (http:// or https://).
# For local development, the backend runs on port 8000 by default.
# For production, use the deployed backend URL.
CG_BACKEND_URL=http://localhost:8000
# CG_BACKEND_URL=https://cyberguard.yourcompany.com

# ── Batching ────────────────────────────────────────────────────────────────
# How many events to send per HTTP request. Higher = fewer requests but
# larger payloads. Backend caps batch size at 500.
CG_BATCH_SIZE=100

# How often the sender flushes the queue (seconds). Lower = faster delivery
# but more network overhead. Minimum 1, recommended 10-30.
CG_BATCH_INTERVAL_SECONDS=10

# ── Heartbeat ───────────────────────────────────────────────────────────────
# How often to send a heartbeat (seconds). Backend marks the source as
# "disconnected" if no heartbeat arrives for 300 seconds. Keep this at
# least 2× below that threshold to allow retries.
CG_HEARTBEAT_INTERVAL_SECONDS=60

# ── Local queue ─────────────────────────────────────────────────────────────
# Maximum number of events held in the local SQLite queue. When exceeded,
# the OLDEST events are dropped. 10,000 events ≈ 10-20 MB on disk.
CG_MAX_QUEUE_SIZE=10000

# ── Send retry behavior ─────────────────────────────────────────────────────
# How many times to retry a failed batch before dropping it permanently.
# Backend 5xx, network errors, and rate limits are all retried up to this many times.
CG_SEND_RETRY_MAX=5

# Base backoff between retries (seconds). Exponential: 5s, 10s, 20s, 40s...
# Capped at 300s per attempt.
CG_SEND_RETRY_BACKOFF_SECONDS=5

# ── Event log reading ───────────────────────────────────────────────────────
# How often the reader polls Windows Event Logs for new events (seconds).
# Minimum 1, recommended 5-10 (higher = lower CPU, slower event delivery).
CG_READ_POLL_SECONDS=5

# Comma-separated list of Windows Event Log channels to read.
# "Security" requires the collector to run as Administrator or LocalSystem.
# "System" and "Application" are readable by regular users.
# CG_EVENT_CHANNELS=Security,System,Application

# Comma-separated list of specific Windows Event IDs to capture.
# Leave empty or unset to capture ALL events from the configured channels.
# Example (auth + account + service events only):
# CG_EVENT_IDS=4624,4625,4634,4648,4672,4720,4722,4725,4726,4740,7034,7045
CG_EVENT_IDS=

# ── Logging ─────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# DEBUG is verbose (log every event read); INFO is normal;
# WARNING+ hides routine operation and only shows issues.
CG_LOG_LEVEL=INFO

# ── HTTP timeout ────────────────────────────────────────────────────────────
# How long to wait for a single HTTP request before giving up (seconds).
# Backend responses are usually <500ms; 30s allows for retries inside the
# backend without the client timing out first.
CG_HTTP_TIMEOUT_SECONDS=30