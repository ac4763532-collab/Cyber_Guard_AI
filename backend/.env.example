# ============================================================================
# CyberGuard AI — Backend Environment Configuration Template
# ============================================================================
# HOW TO USE:
#   1. Copy this file to `.env` in the same directory:
#        cd E:\CyberGuard\backend
#        Copy-Item .env.example .env
#   2. Fill in real values for any `CHANGE_ME` placeholder.
#   3. NEVER commit the real `.env` file to git.
#
# The `.env` file is loaded by app/core/config.py at startup.
# Every value here MUST have a matching field in the Settings class.
# ============================================================================


# ────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ────────────────────────────────────────────────────────────────────────────
APP_NAME=CyberGuard AI
APP_ENV=development
APP_VERSION=0.1.0
APP_DEBUG=true

# Public-facing URL of the backend (used in emails, reports, CORS)
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173


# ────────────────────────────────────────────────────────────────────────────
# SERVER
# ────────────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Comma-separated list of allowed origins for CORS
# In production, replace with your real frontend domain(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000


# ────────────────────────────────────────────────────────────────────────────
# SECURITY / JWT
# ────────────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_64_CHAR_RANDOM_SECRET_BEFORE_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Password hashing (bcrypt cost factor — 12 is production-safe)
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_INGESTION_PER_MINUTE=600
RATE_LIMIT_GENERAL_PER_MINUTE=120


# ────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL)
# ────────────────────────────────────────────────────────────────────────────
# Local default: postgresql://cyberguard:cyberguard_dev@localhost:5432/cyberguard
# Docker default: postgresql://cyberguard:cyberguard_dev@postgres:5432/cyberguard
DATABASE_URL=postgresql://cyberguard:cyberguard_dev@localhost:5432/cyberguard

# SQLAlchemy engine tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false


# ────────────────────────────────────────────────────────────────────────────
# REDIS (cache + rate limiting + agent state)
# ────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50


# ────────────────────────────────────────────────────────────────────────────
# MESSAGE BROKER (Redpanda / Kafka-compatible)
# ────────────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=cyberguard-backend
KAFKA_GROUP_ID=cyberguard-agents
KAFKA_ENABLED=false

# Topic names (do not change without updating agents + consumers)
KAFKA_TOPIC_SECURITY_EVENTS=security-events
KAFKA_TOPIC_AGENT_TASKS=agent-tasks
KAFKA_TOPIC_AGENT_RESULTS=agent-results
KAFKA_TOPIC_CORRELATIONS=correlations
KAFKA_TOPIC_INCIDENTS=incidents
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_DEAD_LETTER=dead-letter


# ────────────────────────────────────────────────────────────────────────────
# FIREBASE AUTHENTICATION (Phase: Auth)
# ────────────────────────────────────────────────────────────────────────────
# Path to the Firebase service account JSON file (download from Firebase Console)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
FIREBASE_PROJECT_ID=CHANGE_ME_firebase_project_id
FIREBASE_AUTH_ENABLED=false


# ────────────────────────────────────────────────────────────────────────────
# EXTERNAL THREAT INTELLIGENCE APIS (Phase: Threat Intelligence Agent)
# ────────────────────────────────────────────────────────────────────────────
# All APIs below are OPTIONAL for local development.
# The Threat Intelligence Agent will skip any provider whose key is empty.

# VirusTotal — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_RATE_LIMIT_PER_MINUTE=4

# AbuseIPDB — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
ABUSEIPDB_RATE_LIMIT_PER_MINUTE=60

# AlienVault OTX — https://otx.alienvault.com/api
OTX_API_KEY=
OTX_RATE_LIMIT_PER_MINUTE=30

# URLhaus — free, no key required (leave empty)
URLHAUS_ENABLED=true

# NVD / CVE — free, no key required for basic queries
NVD_API_KEY=
NVD_RATE_LIMIT_PER_MINUTE=5

# Google Safe Browsing — https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# MITRE ATT&CK — public, no key required (data is bundled locally)
MITRE_ATTACK_ENABLED=true


# ────────────────────────────────────────────────────────────────────────────
# AI / LLM INTEGRATION (Phase: AI Analyst Agent)
# ────────────────────────────────────────────────────────────────────────────
# Provide at least one provider key to enable AI-assisted investigation.
# If none are set, the AI Analyst Agent falls back to rule-based explanations.

LLM_PROVIDER=none
# Options: none | anthropic | gemini | ollama

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TIMEOUT_SECONDS=60

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b


# ────────────────────────────────────────────────────────────────────────────
# AGENT SETTINGS
# ────────────────────────────────────────────────────────────────────────────
AGENT_EXECUTION_ENABLED=true
AGENT_MAX_RETRIES=3
AGENT_RETRY_BACKOFF_SECONDS=5
AGENT_TASK_TIMEOUT_SECONDS=120
AGENT_BATCH_SIZE=50

# Log Analysis Agent
LOG_AGENT_FAILED_LOGIN_THRESHOLD=5
LOG_AGENT_FAILED_LOGIN_WINDOW_MINUTES=10
LOG_AGENT_PRIVILEGE_ESCALATION_ENABLED=true

# Email Analysis Agent
EMAIL_AGENT_MAX_ATTACHMENT_SIZE_BYTES=26214400
EMAIL_AGENT_SUSPICIOUS_TLD_SCORE=40

# Network Analysis Agent
NETWORK_AGENT_PORT_SCAN_THRESHOLD=20
NETWORK_AGENT_PORT_SCAN_WINDOW_SECONDS=60

# IOC Correlation Agent
IOC_CORRELATION_TIME_WINDOW_MINUTES=30
IOC_CORRELATION_MIN_INDICATORS=2

# Incident Response Agent
INCIDENT_AUTO_CREATE_SEVERITY_THRESHOLD=high
INCIDENT_AGENT_MAX_CASES_PER_ANALYST=20

# Reporting Agent
REPORT_AGENT_MAX_ROWS=10000
REPORT_AGENT_PDF_PAGE_LIMIT=100


# ────────────────────────────────────────────────────────────────────────────
# COLLECTORS (device agents)
# ────────────────────────────────────────────────────────────────────────────
COLLECTOR_ENROLLMENT_TOKEN_TTL_MINUTES=15
COLLECTOR_HEARTBEAT_INTERVAL_SECONDS=60
COLLECTOR_STALE_AFTER_SECONDS=300
COLLECTOR_EVENT_BATCH_MAX_SIZE=500
COLLECTOR_EVENT_MAX_SIZE_BYTES=262144
COLLECTOR_CREDENTIAL_ROTATION_DAYS=90


# ────────────────────────────────────────────────────────────────────────────
# FILE UPLOADS & STORAGE
# ────────────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./static/uploads
REPORT_OUTPUT_DIR=./static/reports
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,text/plain,image/png,image/jpeg


# ────────────────────────────────────────────────────────────────────────────
# LOGGING
# ────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/cyberguard.log
LOG_ROTATION_MB=50
LOG_RETENTION_DAYS=30


# ────────────────────────────────────────────────────────────────────────────
# DATA RETENTION & PRIVACY
# ────────────────────────────────────────────────────────────────────────────
RETENTION_EVENTS_DAYS=90
RETENTION_FINDINGS_DAYS=180
RETENTION_ALERTS_DAYS=365
RETENTION_INCIDENTS_DAYS=730
RETENTION_AUDIT_LOGS_DAYS=1825
PRIVACY_REDACT_EMAIL_BODIES=true
PRIVACY_REDACT_IP_ADDRESSES=false


# ────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY (optional, Phase 13)
# ────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_ENABLED=false
HEALTH_CHECK_PATH=/health


# ────────────────────────────────────────────────────────────────────────────
# EMAIL / NOTIFICATIONS (optional, Phase 10)
# ────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@cyberguard.local
EMAIL_FROM_NAME=CyberGuard AI


# ============================================================================
# END OF CONFIGURATION
# ============================================================================