"""${message}

Revision ID: ${up_revision}
Revises: ${down_revision | comma,n}
Create Date: ${create_date}

================================================================================
SAFETY WARNING — read before editing
================================================================================
DO NOT edit a migration after it has been applied to a shared or production
database. Once a migration is committed and deployed, its content is
**immutable history**. If you need to change the schema, create a NEW
migration.

Editing an already-applied migration:
  - Does not change the schema of databases where it has already run
  - Silently diverges the schema across environments
  - Breaks `alembic upgrade head` on fresh databases in subtle ways
  - Destroys the ability to reason about "what the schema was at commit X"

This warning applies even to "just a comment" edits — the checksum of the
file changes and CI may reject it.
================================================================================
"""

from __future__ import annotations

from typing import Sequence, Union

from alembic import op
import sqlalchemy as sa
${imports if imports else ""}

# ─── Alembic revision identifiers ──────────────────────────────────────────
# These four fields are read by Alembic when resolving the migration chain.
# Do not rename them. Do not change their values.
revision: str = ${repr(up_revision)}
down_revision: Union[str, Sequence[str], None] = ${repr(down_revision)}
branch_labels: Union[str, Sequence[str], None] = ${repr(branch_labels)}
depends_on: Union[str, Sequence[str], None] = ${repr(depends_on)}


def upgrade() -> None:
    """
    Apply this migration.

    For autogenerated migrations, Alembic populates this with the operations
    needed to bring the database from the previous revision's schema to
    the target schema. **Review carefully** — autogenerate can miss things
    (e.g. server-side defaults on existing columns) and can produce
    destructive operations (e.g. DROP COLUMN) that require human judgement.

    For manual migrations, write the operations here. Common patterns:

        # Add a column with a server default (safe for existing rows):
        op.add_column(
            'users',
            sa.Column('full_name', sa.String(255), nullable=True),
        )

        # Add a NOT NULL column (must set server_default or backfill first):
        op.add_column(
            'users',
            sa.Column(
                'timezone', sa.String(64),
                nullable=False,
                server_default='UTC',
            ),
        )

        # Create an index (safe):
        op.create_index(
            'ix_users_email_lower',
            'users',
            [sa.text('lower(email)')],
            unique=True,
        )

        # Rename a column (PostgreSQL supports ALTER RENAME):
        op.alter_column('users', 'old_name', new_column_name='new_name')

        # For non-trivial changes, split across migrations (add → backfill
        # → enforce constraints) rather than doing it all in one file.
    """
    ${upgrades if upgrades else "pass"}


def downgrade() -> None:
    """
    Reverse this migration.

    For autogenerated migrations, Alembic attempts to generate the reverse
    operations. In some cases (e.g. dropping a column that held data) the
    downgrade is necessarily lossy — the data is gone. Read this carefully
    and adjust if needed.

    If the migration is genuinely irreversible (e.g. it removes a column
    that has been dropped from the model), replace the body with:

        raise NotImplementedError(
            "This migration is irreversible; restore from backup if needed."
        )

    This is better than a half-working downgrade that leaves the DB in an
    inconsistent state.
    """
    ${downgrades if downgrades else "pass"}